# Score tensors for the mask-composition figures (plots/plot_mask_composition.py). LFS rather than
# plain git: they are ~6.6 MB binaries that git cannot diff and that would bloat every clone's pack.
# Scoped to these two directories on purpose -- the other 196 local `final.pt` copies are 1.3 GB and
# stay ignored, which keeps this inside GitHub's 1 GB free LFS quota.
plots/data/fr2de8b_r32_posthoc/**/final.pt filter=lfs diff=lfs merge=lfs -text
plots/data/refusal_grpo/**/final.pt filter=lfs diff=lfs merge=lfs -text
*.pt !text !filter !merge !diff
